        // ==================== VISION ====================
        async function loadFaceModels() {
            if (window.faceModelsLoaded) return;
            const status = document.getElementById('visionStatus');
            const retryBtn = document.getElementById('retryModels');
            status.textContent = 'Loading face models...';
            retryBtn.style.display = 'none';

            const MODEL_URL = 'https://raw.githubusercontent.com/justadudewhohacks/face-api.js/master/weights';

            try {
                await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
                await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
                await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
                modelsReady = true;
                window._faceLoaded = true;
                window.faceModelsLoaded = true;
                loadStoredFaces();
                status.textContent = '✅ Face recognition ready.';
                try { localStorage.setItem('kalax_face_model_url', MODEL_URL); } catch(e) {}
            } catch (e) {
                status.textContent = '⚠️ Face models failed to load. Please check your internet and try again.';
                retryBtn.style.display = 'inline-block';
            }
        }

        window.addEventListener('load', () => {
            if (typeof faceapi !== 'undefined') loadFaceModels();
        });

        function loadStoredFaces() {
            try {
                const stored = localStorage.getItem('kalax_faces');
                if (stored) {
                    const faces = JSON.parse(stored);
                    labeledDescriptors = faces.map(f => new faceapi.LabeledFaceDescriptors(f.label, f.descriptors.map(d => new Float32Array(d))));
                    faceMatcher = labeledDescriptors.length ? new faceapi.FaceMatcher(labeledDescriptors) : null;
                }
            } catch(e) {}
        }

        function saveFaces() {
            faceMatcher = labeledDescriptors.length ? new faceapi.FaceMatcher(labeledDescriptors) : null;
            try {
                localStorage.setItem('kalax_faces', JSON.stringify(
                    labeledDescriptors.map(ld => ({ label: ld.label, descriptors: ld.descriptors.map(d => Array.from(d)) }))
                ));
            } catch(e) {}
        }

        async function getDescriptorFromFile(file) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = async () => {
                    const canvas = document.createElement('canvas');
                    canvas.width = img.width; canvas.height = img.height;
                    canvas.getContext('2d').drawImage(img, 0, 0);
                    const detections = await faceapi.detectAllFaces(canvas, new faceapi.TinyFaceDetectorOptions())
                        .withFaceLandmarks().withFaceDescriptors();
                    if (detections.length === 0) reject(new Error('No face detected.'));
                    else resolve(detections[0].descriptor);
                };
                img.onerror = () => reject(new Error('Invalid image'));
                img.src = URL.createObjectURL(file);
            });
        }

        async function registerFace() {
            if (!modelsReady) return showToast('Face models not ready.');
            const name = document.getElementById('regName').value.trim();
            const role = document.getElementById('regRole').value;
            const file = document.getElementById('regFile').files[0];
            if (!name || !file) return showToast('Enter name and select a photo');
            try {
                const desc = await getDescriptorFromFile(file);
                const label = `${role}_${name}`;
                labeledDescriptors = labeledDescriptors.filter(ld => ld.label !== label);
                labeledDescriptors.push(new faceapi.LabeledFaceDescriptors(label, [desc]));
                saveFaces();
                showToast(`✅ Registered: ${label}`);
                document.getElementById('regFile').value = '';
                document.getElementById('regName').value = '';
                loadAttendance();
            } catch (e) { showToast('Registration failed. Use a clear front-face photo.'); }
        }

        async function recognizeFace() {
            if (!modelsReady) return showToast('Face models not ready.');
            if (!faceMatcher) return showToast('No faces registered.');
            const file = document.getElementById('recogFile').files[0];
            if (!file) return showToast('Select a photo');
            try {
                const desc = await getDescriptorFromFile(file);
                const match = faceMatcher.findBestMatch(desc);
                if (match.distance < 0.6) {
                    const [role, ...nameParts] = match.label.split('_');
                    const displayName = nameParts.join('_');
                    const now = new Date();
                    attendanceLog.push({ name: displayName, role, date: now.toISOString().slice(0,10), time: now.toTimeString().slice(0,5) });
                    try { localStorage.setItem('kalax_attendance', JSON.stringify(attendanceLog)); } catch(e) {}
                    updateAttendanceUI();
                    showToast(`✅ Recognized: ${displayName} (${role})`);
                } else showToast('❌ Face not recognized.');
            } catch (e) { showToast('Recognition failed.'); }
            document.getElementById('recogFile').value = '';
        }

        function loadAttendance() {
            try { attendanceLog = JSON.parse(localStorage.getItem('kalax_attendance') || '[]'); } catch(e) { attendanceLog = []; }
            updateAttendanceUI();
        }

        function updateAttendanceUI() {
            const container = document.getElementById('attendanceLog');
            if (!attendanceLog.length) { container.innerHTML = '<div style="padding:8px; color:var(--gray-500);">No records yet.</div>'; return; }
            container.innerHTML = attendanceLog.slice(-20).reverse().map(e => 
                `<div style="padding:4px 0; border-bottom:1px solid var(--gray-100);"><strong>${e.name}</strong> · ${e.role} <span style="float:right; color:var(--gray-500);">${e.date} ${e.time}</span></div>`
            ).join('');
        }

        function generateCSV() {
            if (!attendanceLog.length) return '';
            return 'Name,Role,Date,Time\n' + attendanceLog.map(e => `${e.name},${e.role},${e.date},${e.time}`).join('\n');
        }

        function downloadCSV() {
            const csv = generateCSV();
            if (!csv) { showToast('No records to export.'); return; }
            const blob = new Blob([csv], { type: 'text/csv' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `kalaX_attendance_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
            showToast('CSV downloaded.');
        }

        async function shareCSV() {
            const csv = generateCSV();
            if (!csv) { showToast('No records to share.'); return; }
            if (navigator.share) {
                try { await navigator.share({ files: [new File([csv], 'attendance.csv', { type: 'text/csv' })], title: 'KalaX Attendance' }); }
                catch (e) { showToast('Share cancelled.'); }
            } else downloadCSV();
        }

        document.getElementById('retryModels').addEventListener('click', loadFaceModels);

        // ==================== TOOL MEASUREMENT (POINTS ON DOWN – FIXED) ====================
        const toolCanvas = document.getElementById('toolCanvas');
        const toolCtx = toolCanvas.getContext('2d');
        const toolWrapper = document.getElementById('toolCanvasWrapper');

        function getCoinSizeMm() {
            const customVal = parseFloat(document.getElementById('customCoinSize').value);
            if (!isNaN(customVal) && customVal > 0) return customVal;
            const selectVal = parseFloat(document.getElementById('coinType').value);
            return isNaN(selectVal) ? 27 : selectVal;
        }

        document.getElementById('toolFile').addEventListener('change', e => {
            const file = e.target.files[0];
            if (!file) return;
            const img = new Image();
            img.onload = () => {
                toolImg = img;
                originalWidth = img.width;
                originalHeight = img.height;
                displayWidth = Math.min(500, originalWidth);
                displayHeight = (displayWidth / originalWidth) * originalHeight;
                toolCanvas.width = displayWidth;
                toolCanvas.height = displayHeight;
                toolCanvas.style.width = displayWidth + 'px';
                toolCanvas.style.height = displayHeight + 'px';
                toolCanvas.style.maxWidth = 'none';
                refPoints = []; objPoints = [];
                toolMode = null; toolZoom = 1; panX = 0; panY = 0;
                updateCanvasTransform();
                document.getElementById('setRefTool').disabled = false;
                document.getElementById('setObjTool').disabled = true;
                document.getElementById('computeTool').disabled = true;
                redrawTool();
            };
            img.src = URL.createObjectURL(file);
        });

        function updateCanvasTransform() {
            toolCanvas.style.transform = `translate(${panX}px, ${panY}px) scale(${toolZoom})`;
            toolCanvas.style.transformOrigin = '0 0';
        }

        function redrawTool() {
            if (!toolImg) {
                toolCtx.clearRect(0, 0, toolCanvas.width, toolCanvas.height);
                toolCtx.fillStyle = '#64748b';
                toolCtx.font = '14px sans-serif';
                toolCtx.fillText('Load an image', toolCanvas.width/2-60, toolCanvas.height/2);
                return;
            }
            toolCtx.clearRect(0, 0, toolCanvas.width, toolCanvas.height);
            toolCtx.drawImage(toolImg, 0, 0, displayWidth, displayHeight);
            if (refPoints.length >= 1) {
                refPoints.forEach((p, i) => {
                    const px = p.x * (displayWidth/originalWidth);
                    const py = p.y * (displayHeight/originalHeight);
                    toolCtx.fillStyle = 'red';
                    toolCtx.beginPath(); toolCtx.arc(px, py, 5, 0, 2*Math.PI); toolCtx.fill();
                    toolCtx.fillStyle = 'white';
                    toolCtx.font = 'bold 10px system-ui';
                    toolCtx.fillText(i+1, px-3, py+4);
                });
                if (refPoints.length === 2) {
                    const x1 = refPoints[0].x*(displayWidth/originalWidth), y1 = refPoints[0].y*(displayHeight/originalHeight);
                    const x2 = refPoints[1].x*(displayWidth/originalWidth), y2 = refPoints[1].y*(displayHeight/originalHeight);
                    toolCtx.strokeStyle = 'red'; toolCtx.lineWidth = 2;
                    toolCtx.beginPath(); toolCtx.moveTo(x1, y1); toolCtx.lineTo(x2, y2); toolCtx.stroke();
                }
            }
            if (objPoints.length >= 1) {
                objPoints.forEach((p, i) => {
                    const px = p.x * (displayWidth/originalWidth);
                    const py = p.y * (displayHeight/originalHeight);
                    toolCtx.fillStyle = 'blue';
                    toolCtx.beginPath(); toolCtx.arc(px, py, 5, 0, 2*Math.PI); toolCtx.fill();
                    toolCtx.fillStyle = 'white';
                    toolCtx.font = 'bold 10px system-ui';
                    toolCtx.fillText(i+1, px-3, py+4);
                });
                if (objPoints.length === 2) {
                    const x1 = objPoints[0].x*(displayWidth/originalWidth), y1 = objPoints[0].y*(displayHeight/originalHeight);
                    const x2 = objPoints[1].x*(displayWidth/originalWidth), y2 = objPoints[1].y*(displayHeight/originalHeight);
                    toolCtx.strokeStyle = 'blue'; toolCtx.lineWidth = 2;
                    toolCtx.beginPath(); toolCtx.moveTo(x1, y1); toolCtx.lineTo(x2, y2); toolCtx.stroke();
                }
            }
        }

        function screenToOriginal(screenX, screenY) {
            const canvasX = (screenX - panX) / toolZoom;
            const canvasY = (screenY - panY) / toolZoom;
            if (canvasX < 0 || canvasX >= displayWidth || canvasY < 0 || canvasY >= displayHeight) return null;
            const origX = (canvasX / displayWidth) * originalWidth;
            const origY = (canvasY / displayHeight) * originalHeight;
            return { x: origX, y: origY };
        }

        function getEventPoint(e) {
            const rect = toolWrapper.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        function onPointerDown(e) {
            e.preventDefault();
            if (!toolImg) return;
            const pt = getEventPoint(e);

            if (toolMode) {
                const now = Date.now();
                if (now - lastPointTime < 300) return; // ignore duplicate within 300ms
                lastPointTime = now;

                const orig = screenToOriginal(pt.x, pt.y);
                if (orig) {
                    if (toolMode === 'ref') {
                        refPoints.push(orig);
                        if (refPoints.length === 2) {
                            toolMode = null;
                            document.getElementById('setObjTool').disabled = false;
                            showToast('Reference set. Now set object points.');
                        }
                    } else if (toolMode === 'obj') {
                        objPoints.push(orig);
                        if (objPoints.length === 2) {
                            toolMode = null;
                            document.getElementById('computeTool').disabled = false;
                            showToast('Object points set. Click Compute.');
                        }
                    }
                    redrawTool();
                }
            } else {
                isPanning = true;
                lastPanPoint = { x: pt.x, y: pt.y };
            }
        }

        function onPointerMove(e) {
            if (!isPanning) return;
            e.preventDefault();
            const pt = getEventPoint(e);
            const dx = pt.x - lastPanPoint.x, dy = pt.y - lastPanPoint.y;
            panX += dx; panY += dy;
            lastPanPoint = { x: pt.x, y: pt.y };
            updateCanvasTransform();
        }

        function onPointerUp(e) {
            if (isPanning) isPanning = false;
        }

        toolWrapper.addEventListener('mousedown', onPointerDown);
        toolWrapper.addEventListener('mousemove', onPointerMove);
        toolWrapper.addEventListener('mouseup', onPointerUp);
        toolWrapper.addEventListener('mouseleave', onPointerUp);
        toolWrapper.addEventListener('touchstart', onPointerDown, {passive: false});
        toolWrapper.addEventListener('touchmove', onPointerMove, {passive: false});
        toolWrapper.addEventListener('touchend', onPointerUp);
        toolWrapper.addEventListener('touchcancel', onPointerUp);

        document.getElementById('setRefTool').onclick = () => {
            if (!toolImg) return showToast('Load an image first');
            toolMode = 'ref'; refPoints = []; objPoints = [];
            document.getElementById('setObjTool').disabled = true;
            document.getElementById('computeTool').disabled = true;
            redrawTool();
            showToast('Tap two points on the coin.');
        };
        document.getElementById('setObjTool').onclick = () => {
            if (refPoints.length !== 2) return showToast('Set reference points first');
            toolMode = 'obj'; objPoints = [];
            document.getElementById('computeTool').disabled = true;
            redrawTool();
            showToast('Tap two points on the object.');
        };
        document.getElementById('computeTool').onclick = async () => {
            if (refPoints.length !== 2 || objPoints.length !== 2) return;
            const refDist = Math.hypot(refPoints[1].x - refPoints[0].x, refPoints[1].y - refPoints[0].y);
            const objDist = Math.hypot(objPoints[1].x - objPoints[0].x, objPoints[1].y - objPoints[0].y);
            const coinMm = getCoinSizeMm();
            try {
                if (isOnline) {
                    const data = await fetch(`${BACKEND}/measure`, {
                        method:'POST', headers: {'Content-Type':'application/json'},
                        body: JSON.stringify({ reference_actual_cm: coinMm/10, reference_pixels: refDist, object_pixels: objDist, explain: true })
                    }).then(r => r.json());
                    document.getElementById('toolResult').innerHTML = `📐 ${data.actual_cm} cm (${data.actual_inches} in)<br>${data.explanation || ''}`;
                } else {
                    const actualCm = (objDist / refDist) * (coinMm/10);
                    const actualIn = actualCm / 2.54;
                    document.getElementById('toolResult').innerHTML = `📐 ${actualCm.toFixed(2)} cm (${actualIn.toFixed(2)} in) [offline]`;
                }
            } catch (e) { document.getElementById('toolResult').innerHTML = '❌ Measurement failed.'; }
        };
        document.getElementById('clearTool').onclick = () => {
            refPoints = []; objPoints = [];
            redrawTool();
            document.getElementById('setObjTool').disabled = true;
            document.getElementById('computeTool').disabled = true;
            document.getElementById('toolResult').innerHTML = '';
        };
        document.getElementById('zoomInBtn').onclick = () => { toolZoom = Math.min(toolZoom + 0.3, 4); updateCanvasTransform(); };
        document.getElementById('zoomOutBtn').onclick = () => { toolZoom = Math.max(toolZoom - 0.3, 0.5); updateCanvasTransform(); };
        document.getElementById('resetZoomBtn').onclick = () => { toolZoom = 1; panX = 0; panY = 0; updateCanvasTransform(); };

        // ==================== DIAGRAMS ====================
        function drawDiagram(type) {
            const canvas = document.getElementById('diagramCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 400; canvas.height = 300;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.strokeStyle = '#1a56db'; ctx.fillStyle = '#1a56db'; ctx.lineWidth = 2; ctx.font = '14px system-ui';
            const cx = canvas.width/2, cy = canvas.height/2;
            switch(type) {
                case 'circle': ctx.beginPath(); ctx.arc(cx, cy, 80, 0, 2*Math.PI); ctx.stroke(); ctx.fillText('r = 80', cx+30, cy-10); break;
                case 'triangle': ctx.beginPath(); ctx.moveTo(cx, cy-80); ctx.lineTo(cx+90, cy+60); ctx.lineTo(cx-90, cy+60); ctx.closePath(); ctx.stroke(); ctx.fillText('A', cx, cy-90); ctx.fillText('B', cx+100, cy+70); ctx.fillText('C', cx-110, cy+70); break;
                case 'square': ctx.strokeRect(cx-70, cy-70, 140, 140); ctx.fillText('side = 140', cx-40, cy+85); break;
                case 'parabola': ctx.beginPath(); ctx.moveTo(50, 250); for (let x = 0; x <= 300; x+=5) { const xn = (x/150)-1; ctx.lineTo(50+x, 250-xn*xn*100); } ctx.stroke(); ctx.fillText('y = x²', 320, 50); break;
            }
        }
        function clearDiagram() {
            const canvas = document.getElementById('diagramCanvas');
            canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
        }

        // ==================== INIT ====================
        loadAttendance();
        setTimeout(() => drawDiagram('circle'), 500);
    </script>
