        function searchOfflineKB(query) {
            const q = query.toLowerCase().trim();

            // 1. Exact or partial phrasing match (best quality match)
            for (const entry of offlineContentBank) {
                for (const phrase of entry.phrasings) {
                    if (q.includes(phrase) || phrase.includes(q)) {
                        return formatOfflineAnswer(entry);
                    }
                }
            }

            // 2. Loose word-overlap match as a fallback (catches different phrasing)
            const qWords = q.split(/\s+/).filter(w => w.length > 3);
            let bestMatch = null, bestScore = 0;
            for (const entry of offlineContentBank) {
                for (const phrase of entry.phrasings) {
                    const phraseWords = phrase.split(/\s+/);
                    const overlap = phraseWords.filter(w => qWords.includes(w)).length;
                    if (overlap > bestScore) { bestScore = overlap; bestMatch = entry; }
                }
            }
            if (bestMatch && bestScore >= 2) return formatOfflineAnswer(bestMatch);

            return "I'm offline and don't have that topic in my study bank yet. Try rephrasing, or ask again once connected for full AI help.";
        }

        function formatOfflineAnswer(entry) {
            let answer = entry.explanation;
            if (entry.example) answer += `<br><br><em>Example: ${entry.example}</em>`;
            return answer;
        }

        function plotGraph(expr) {
            const modal = document.createElement('div');
            modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:3000;';
            const inner = document.createElement('div');
            inner.style.cssText = 'background:white;padding:20px;border-radius:12px;width:80%;max-width:700px;';
            inner.innerHTML = `<h3>Graph: y = ${expr}</h3><canvas id="graphCanvas" width="600" height="400"></canvas><br><button class="btn btn-outline" onclick="this.parentElement.parentElement.remove()">Close</button>`;
            modal.appendChild(inner);
            document.body.appendChild(modal);
            const ctx = document.getElementById('graphCanvas').getContext('2d');
            if (chartInstance) chartInstance.destroy();
            const data = generateGraphData(expr);
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: { labels: data.xVals, datasets: [{ label: `y = ${expr}`, data: data.yVals, borderColor: '#1a56db', borderWidth: 2, pointRadius: 0 }] },
                options: { responsive: true }
            });
        }

        function generateGraphData(expr) {
            const xVals = [], yVals = [];
            for (let x = -6; x <= 6; x += 0.1) {
                xVals.push(parseFloat(x.toFixed(1)));
                try { yVals.push(eval(expr.replace(/\^/g, '**').replace(/x/g, `(${x})`))); } catch (e) { yVals.push(null); }
            }
            return { xVals, yVals };
        }

        function plotGraphFromInput() {
            const expr = document.getElementById('graphEquation').value.trim();
            if (!expr) return showToast('Enter an equation');
            plotGraph(expr);
        }

        // ==================== AGRICULTURE ====================
        document.getElementById('agriLanguage').addEventListener('change', e => agriLanguage = e.target.value);

        async function diagnoseCrop() {
