        function searchAgriOffline(query) {
            const db = {
                "maize streak": "Maize Streak Virus – Use resistant varieties, neem oil spray.",
                "coffee rust": "Coffee Rust – Apply copper fungicide.",
                "cassava mosaic": "Cassava Mosaic – Use disease-free cuttings.",
                "banana wilt": "Banana Bacterial Wilt – Remove infected plants, disinfect tools.",
                "cattle east coast fever": "East Coast Fever – Treat with buparvaquone, control ticks.",
                "chicken newcastle": "Newcastle Disease – Vaccinate chicks, maintain biosecurity."
